---
import { SITE, AUDIENCES } from '../config/site';
---

<section class="hero" id="top">
  <div class="wrap wrap-wide hero-inner">
    <div class="hero-text">
      <p class="hero-kicker">{SITE.jobTitle}, {SITE.affiliation}</p>
      <h1 class="hero-name">{SITE.name}</h1>
      <p class="hero-tagline">{SITE.tagline}.</p>
      <p class="hero-vision">{SITE.visionLine}</p>

      <nav class="router" aria-label="Jump to a section">
        {AUDIENCES.map((a) => (
          <a href={a.href}>{a.label}</a>
        ))}
      </nav>
    </div>

    <div class="hero-portrait" aria-hidden={SITE.headshot ? 'false' : 'true'}>
      <div class="sunrise">
        <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A rising sun, a motif for dawn and renewal">
          <defs>
            <clipPath id="disc"><circle cx="120" cy="120" r="116" /></clipPath>
          </defs>
          <g clip-path="url(#disc)">
            <rect width="240" height="240" fill="var(--paper-2)" />
            <circle cx="120" cy="250" r="150" fill="var(--accent-bright)" opacity="0.92" />
            <circle cx="120" cy="290" r="120" fill="var(--accent)" opacity="0.95" />
          </g>
          <circle cx="120" cy="120" r="116" fill="none" stroke="var(--line-strong)" stroke-width="1.5" />
        </svg>
        {SITE.headshot && (
          <img
            class="headshot"
            src={SITE.headshot}
            alt={SITE.headshotAlt}
            width="240"
            height="240"
            loading="eager"
            decoding="async"
          />
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 720px) {
    .hero-inner {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .hero-kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: var(--space-s);
  }

  .hero-name {
    font-size: var(--step-4);
    font-weight: 540;
    line-height: 1;
    margin-bottom: var(--space-m);
  }

  .hero-tagline {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--ink);
    margin-bottom: var(--space-s);
    max-width: 22ch;
  }

  .hero-vision {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: 46ch;
  }

  .router {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-l);
  }

  .router a {
    position: relative;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 2px;
  }

  .router a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--line-strong);
    transition: background 0.15s ease;
  }

  .router a:hover {
    color: var(--accent);
  }
  .router a:hover::after {
    background: var(--accent);
  }

  .hero-portrait {
    justify-self: center;
  }

  .sunrise {
    position: relative;
    width: clamp(11rem, 26vw, 16rem);
    aspect-ratio: 1;
  }

  .sunrise svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 10px 30px color-mix(in srgb, var(--ink) 14%, transparent));
  }

  .headshot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    /* The headshot sits over the sunrise disc when a real photo is provided.
       The placeholder SVG headshot is transparent, letting the sun show. */
  }
</style>
