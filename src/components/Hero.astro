---
import { SITE, AUDIENCES } from '../config/site';

// Split the hero statement on {curly braces} so the inner phrase renders in
// the cobalt accent. Falls back gracefully if no braces.
const raw = SITE.heroStatement;
const m = raw.match(/^(.*?)\{(.*?)\}(.*)$/s);
const parts = m ? { before: m[1], hl: m[2], after: m[3] } : { before: raw, hl: '', after: '' };

const specs = [
  { k: 'Role', v: SITE.jobTitle },
  { k: 'Institution', v: SITE.affiliation },
  { k: 'Field', v: 'Neuroscience / Stem cells' },
  { k: 'Location', v: 'Stanford, CA' },
];
---

<section class="hero" id="top" data-accent="sun">
  <div class="wrap wrap-wide">
    <div class="hero-top mono">
      <span>Dhriti Nagar</span>
      <span>Dept. of Pediatrics</span>
      <span>Est. 2022</span>
    </div>

    <div class="hero-grid">
      <dl class="specs">
        {specs.map((s) => (
          <div class="spec">
            <dt class="mono">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>

      <div class="hero-main">
        <h1 class="hero-headline">
          {parts.before}{parts.hl && <span class="hl">{parts.hl}</span>}{parts.after}
        </h1>
        <p class="hero-sub">{SITE.visionLine}</p>
        <nav class="router" aria-label="Jump to a section">
          {AUDIENCES.map((a) => (
            <a class="tag" href={a.href}>{a.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <ul class="index" aria-label="Research at a glance">
      <li><span class="mono n">01</span> Brain organoids</li>
      <li><span class="mono n">02</span> Assembloids</li>
      <li><span class="mono n">03</span> Neonatal brain injury</li>
      <li><span class="mono n">04</span> 22q11.2DS</li>
      <li><span class="mono n">05</span> Epilepsy</li>
      <li><span class="mono n">06</span> Therapeutics</li>
    </ul>
  </div>
</section>

<style>
  .hero { padding-block: clamp(2rem, 5vw, 3rem) clamp(2rem, 5vw, 3rem); }

  .hero-top {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding-bottom: 0.9rem;
    border-bottom: 1.5px solid var(--rule);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.6rem, 4vw, 2.6rem);
    padding-block: clamp(2rem, 6vw, 4rem);
  }
  @media (min-width: 800px) {
    .hero-grid { grid-template-columns: minmax(11rem, 0.8fr) 2.6fr; }
  }

  .specs { display: grid; gap: 0; align-content: start; }
  .spec {
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
  }
  .spec:first-child { border-top: none; padding-top: 0; }
  .spec dt { margin: 0; }
  .spec dd { margin: 0; font-size: var(--step-0); font-weight: 500; color: var(--ink); }

  .hero-headline {
    font-size: var(--step-4);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 16ch;
  }
  .hero-headline .hl {
    color: var(--accent-contrast);
    background: var(--accent-field);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0 0.12em;
    margin: 0 -0.02em;
  }

  .hero-sub {
    margin-top: var(--space-m);
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: 1.45;
    max-width: 46ch;
  }

  .router { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--space-l); }
  .tag {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tag:hover { border-color: var(--accent); color: var(--accent); }

  .index {
    list-style: none;
    margin: 0;
    padding: 1rem 0 0;
    border-top: 1.5px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem 1.5rem;
    font-size: var(--step--1);
    font-weight: 500;
  }
  @media (min-width: 640px) { .index { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .index { grid-template-columns: repeat(6, 1fr); } }
  .index li { display: flex; align-items: baseline; gap: 0.5rem; }
  .index .n { color: var(--accent); }
</style>
