---
import { SITE, NAV } from '../config/site';
---

<header class="nav">
  <div class="wrap wrap-wide nav-inner">
    <a class="nav-brand" href="/">{SITE.name}</a>

    <nav class="nav-links" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
      title="Toggle light and dark"
    >
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    min-height: 4rem;
  }

  .nav-brand {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 560;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.6rem, 2vw, 1.4rem);
    margin-left: auto;
  }

  .nav-links a {
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .icon-moon {
    display: none;
  }

  :root[data-theme='dark'] .icon-sun {
    display: none;
  }
  :root[data-theme='dark'] .icon-moon {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun {
      display: none;
    }
    :root:not([data-theme='light']) .icon-moon {
      display: block;
    }
  }

  /* On small screens, drop the inline nav links; brand + toggle remain.
     Sections are reachable by scrolling and from the footer. */
  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var root = document.documentElement;
      var current = root.getAttribute('data-theme');
      var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      // Resolve the effective theme, then flip it.
      var effective = current === 'dark' || current === 'light' ? current : systemDark ? 'dark' : 'light';
      var next = effective === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {}
    });
  })();
</script>
